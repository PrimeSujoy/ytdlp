# Required
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/nextube
API_ID=12345678
API_HASH=your_telegram_api_hash
BOT_TOKEN=1234567890:your_bot_token
OWNER_ID=123456789

# Optional access and channel settings (comma or space separated where noted)
ADMIN_ID=123456789
FORCESUB=
DUMP_CHANNEL=0
LOG_CHANNEL=0
STRING_SESSION=
PREMIUM_API_ID=
PREMIUM_API_HASH=

# Optional yt-dlp proxy
YTDLP_PROXY_URL=
YTDLP_PROXY_USERNAME=
YTDLP_PROXY_PASSWORD=
YTDLP_PROXY_MODE=all
YTDLP_CONCURRENT_FRAGMENTS=2

# Local defaults. Docker and managed-platform manifests override DATA_DIR.
PORT=7860
DATA_DIR=./data
